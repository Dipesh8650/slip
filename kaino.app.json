{
  "$schema": "https://developers.kainostore.com/schemas/app-manifest-v1.json",
  "schemaVersion": 1,
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "runtime": {
    "port": 3000,
    "healthPath": "/health"
  },
  "database": {
    "type": "postgres",
    "migrationCommand": ["node", "migrate.mjs"]
  }
}
